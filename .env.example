# Application
NODE_ENV=development
APP_NAME=nestjs-boiler-plate
PORT=3000
API_PREFIX=api
API_VERSION=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs_boiler_plate

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d

# Two-factor authentication
TWO_FACTOR_ENABLED=true
# Encrypts the TOTP secret at rest. Rotating it invalidates every stored secret.
TWO_FACTOR_ENCRYPTION_KEY=change-me
# Shown as the account name in the authenticator app.
TWO_FACTOR_ISSUER='NestJS Boilerplate'

# Cache
# redis, valkey, or memory. memory is for local development only.
CACHE_BACKEND=redis
# One connection string, including credentials, TLS and database. Valkey uses
# the same scheme, for example rediss://default:password@host:port/0
CACHE_URL=redis://localhost:6379/0
# Namespace applied to every key, so one database can host several apps.
CACHE_KEY_PREFIX=nestjs_boiler_plate
# Default entry lifetime in seconds.
CACHE_DEFAULT_TTL=300
# Lifetime of a "not found" answer, kept short on purpose.
CACHE_EMPTY_TTL=10
# How long to wait for the cache before giving up, in milliseconds.
CACHE_CONNECT_TIMEOUT=2000

# Security headers (helmet)
SECURITY_ENABLED=true
# Leave off while the Swagger UI is served, since it needs inline scripts.
SECURITY_CONTENT_SECURITY_POLICY=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_REFERRER_POLICY=no-referrer

# CORS. Leave CORS_ORIGINS empty for same-origin only, which is the right
# default for an API that is not called from a browser.
CORS_ORIGINS=
# Needed for cookies, not for an Authorization header. Requires an explicit
# allow-list above; a wildcard is rejected in production.
CORS_CREDENTIALS=false
CORS_MAX_AGE=86400

# Rate limiting, applied globally and tightened per route with @Throttle
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_BLOCK_DURATION=0

# Seed
# There is no default on purpose: a seeded account with a published password is
# a published account. At least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE='NestJS Boilerplate API'
SWAGGER_DESCRIPTION='Production-ready NestJS boilerplate API documentation'
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Observe
OBSERVE_APP_KEY=YOUR_APP_KEY
OBSERVE_APP_SECRET=YOUR_APP_SECRET
OBSERVE_SERVICE_ID=nestjs-boiler-plate